<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
{% capture resource_title %}{{ title | strip_html | strip_newlines }}{% endcapture %}
{% seo %}

{% if resource.data.markdown_url %}
<link rel="alternate" type="text/markdown" href="{{ resource.data.markdown_url | absolute_url | escape }}" title="Markdown version" />
{% endif %}

<link rel="stylesheet" href="{% asset_path css %}" />
<script src="{% asset_path js %}" defer></script>
{% live_reload_dev_js %}
{% feed_meta %}

{% if resource.data.permalink == "/about/" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "David Stosik",
  "url": "{{ site.url }}",
  "image": "{{ "/images/profile.jpg" | absolute_url }}",
  "email": "mailto:hi@davidstosik.me",
  "jobTitle": "Staff-level Ruby engineer",
  "description": "French Ruby developer based in rural Nagano, Japan.",
  "knowsLanguage": ["fr", "en", "ja"],
  "sameAs": [
    "https://github.com/davidstosik",
    "https://www.linkedin.com/in/davidstosik/",
    "https://x.com/davidstosik",
    "https://famichiki.jp/@davidstosik"
  ]
}
</script>
{% endif %}
